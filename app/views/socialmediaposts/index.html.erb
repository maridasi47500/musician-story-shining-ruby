<p style="color: green"><%= notice %></p>

<% content_for :title, "Socialmediaposts" %>

<h1>Socialmediaposts</h1>

<div id="socialmediaposts">
  <% @socialmediaposts.each do |socialmediapost| %>
    <%= render socialmediapost %>
    <p>
      <%= link_to "Show this socialmediapost", socialmediapost %>
    </p>
  <% end %>
</div>

<%= link_to "New socialmediapost", new_socialmediapost_path %>
